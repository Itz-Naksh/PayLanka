# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
#  - Local:  run `npx prisma dev --name paylanka --detach` and paste the URL it prints
#  - Neon / Supabase: use the pooled connection string from your dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/paylanka?sslmode=require"

# Neon / Supabase only: the DIRECT (non-pooled) connection string, used for migrations.
# Leave empty locally.
DIRECT_DATABASE_URL=""

# Local `prisma dev` only: its shadow database (the TCP port one above DATABASE_URL's,
# shown by `npx prisma dev ls`). Leave empty for Neon / Supabase.
SHADOW_DATABASE_URL=""

# Secret used by Auth.js to sign session tokens.
# Generate one with:  npx auth secret   (or any random 32+ byte base64 string)
AUTH_SECRET="replace-me"

# Public demo: shows one-click "Try as Admin / HR / Employee" buttons on the
# sign-in page and blocks demo accounts from changing passwords or users.
# Use "true" only for a demo with fake data — never for a real company.
DEMO_MODE="false"

# Needed when running `npm start` locally or self-hosting (Vercel sets this automatically).
AUTH_TRUST_HOST="true"

# The first real Admin account, created by `npm run db:seed`.
# Password rules: 8+ characters with at least one letter and one number.
# Use your own values; the seed refuses to run without them.
SEED_ADMIN_EMAIL="you@yourcompany.lk"
SEED_ADMIN_PASSWORD="choose-a-strong-password-1"
SEED_ADMIN_NAME="Your Name"

# Secret for the nightly demo reset (/api/cron/reset-demo, scheduled in vercel.json).
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# The reset only runs when DEMO_MODE="true". Generate: openssl rand -hex 24
CRON_SECRET=""
