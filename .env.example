# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
#  - Local:  run `npx prisma dev --name paylanka --detach` and paste the URL it prints
#  - Neon / Supabase: use the pooled connection string from your dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/paylanka?sslmode=require"

# Secret used by Auth.js to sign session tokens.
# Generate one with:  npx auth secret   (or any random 32+ byte base64 string)
AUTH_SECRET="replace-me"

# Show the demo account list on the login page (demo deployments only).
SHOW_DEMO_LOGINS="true"

# Needed when running `npm start` locally or self-hosting (Vercel sets this automatically).
AUTH_TRUST_HOST="true"
